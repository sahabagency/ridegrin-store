# Stripe dashboard → Developers → API keys. Use sk_test_... until you're ready to go live.
STRIPE_SECRET_KEY=
# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
# Locally: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and use the secret it prints.
STRIPE_WEBHOOK_SECRET=
# Optional: every paid order is POSTed here as JSON (Zapier / Make / Google Sheets / Slack webhook).
ORDER_WEBHOOK_URL=
# Optional: newsletter signups and contact messages are POSTed here as JSON.
FORMS_WEBHOOK_URL=
